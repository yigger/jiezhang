.category-manager > .header {
  background-color: var(--primary-color)
  color: #ffffff
  padding: 24px 16px
  font-size: 16px
  font-weight: 500
}

.sub-action-btn {
  font-size: 22px
  color: #409eff
  padding: 4px 12px
  margin-left: 8px
  border-radius: 4px
  border: 1px solid #409eff

  &--danger {
    color: #f56c6c
    border-color: #f56c6c
  }
}
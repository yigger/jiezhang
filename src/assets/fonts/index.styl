@import 'iconfont.css'
  
@font-face {
  font-family: "jz-iconfont"; /* Project id 2523724 */
  // Use the compact WOFF source; mini builds inline it via fontUrlLoaderOption.
  src: url('./iconfont.woff') format('woff');
}

.iconfont {
  font-family: "jz-iconfont" !important;
  font-size: 16PX;
  display: inline-block;
  font-style: normal;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}